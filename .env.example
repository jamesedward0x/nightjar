# Nightjar - environment variable NAMES ONLY. Never commit real values.
# Copy to .env.local for development. All of these are server-runtime only;
# none may ever be prefixed with NEXT_PUBLIC_.

# --- Qwen (the only secret in this project) ---
BITGET_QWEN_API_KEY=
QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
QWEN_MODEL=qwen3.8-max
# THE latency knob. Measured with an identical emit_memo call:
#   false -> 3.9s / 134 output tokens / 0 reasoning tokens
#   true  -> 34.5s / 1195 output tokens / 438 reasoning tokens
# Defaults to false. Only turn it on if you raise FUNCTION_MAX_DURATION_S (Vercel Pro).
QWEN_ENABLE_THINKING=false
# Sent as reasoning.effort only when thinking is on. Accepted by the gateway but measured
# to have no effect on reasoning volume, so it is a no-op knob - kept for completeness.
QWEN_REASONING_EFFORT=low
# Hard ceiling on generated tokens for the whole memo. Defaults to 4000; a live run
# measures ~1230 output tokens, so this is headroom, not a target. Lowering it
# truncates the memo rather than speeding it up meaningfully.
# QWEN_MAX_OUTPUT_TOKENS=4000

# --- Bitget public market data (keyless; do NOT add credentials) ---
BITGET_API_BASE_URL=https://api.bitget.com

# --- App behaviour ---
# live | fixture  (see DECISION.md 7.7 - fixtures are never served in live mode)
# fixture mode replays lib/fixtures/ and the UI must show a permanent NOT-LIVE banner.
NIGHTJAR_MODE=live

# --- Logging ---
# debug | info | warn | error. Field NAMES matching key/token/secret are always redacted.
NIGHTJAR_LOG_LEVEL=info

# Hard cap on tool calls in one research turn. Clamped DOWN only: this may tighten the
# invariant-7 budget, never loosen it.
MAX_TOOL_CALLS=6

# --- Serverless budget ---
# RESEARCH_TIMEOUT_MS is CLAMPED to (FUNCTION_MAX_DURATION_S - 5) * 1000 by
# resolveResearchBudgetMs(), because a budget the platform will not grant is a lie.
# FUNCTION_MAX_DURATION_S must equal the literal `maxDuration` in app/api/research/route.ts
# (Next.js rejects an imported identifier there); tests/unit/budget.test.ts enforces it.
# Vercel Hobby allows 60; Pro allows 300.
RESEARCH_TIMEOUT_MS=90000
FUNCTION_MAX_DURATION_S=60